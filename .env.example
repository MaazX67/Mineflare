# Environment Variables Example

# Minecraft Server Configuration
SERVER_HOST=localhost
SERVER_PORT=25565
SERVER_VERSION=1.20.1

# Bot Configuration
BOT_USERNAME=Mineflare
BOT_PASSWORD=
BOT_ONLINE_MODE=false

# Authentication (Microsoft or Offline)
AUTH_TYPE=offline
# For Microsoft authentication:
# MICROSOFT_EMAIL=your@email.com
# MICROSOFT_PASSWORD=your_password

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./data/logs/bot.log
LOG_PRETTY=true

# Dashboard Configuration
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0

# API Configuration
API_ENABLED=true
API_PORT=3001
API_HOST=0.0.0.0

# Bot Behavior
AUTO_RECONNECT=true
RECONNECT_DELAY=5000
MAX_RECONNECT_ATTEMPTS=10
AUTO_RESPAWN=true
AUTO_EAT=true
AUTO_SLEEP=true

# Performance Settings
PATHFIND_TIMEOUT=30000
PATHFIND_PARTIAL=true
MAX_TASK_QUEUE_SIZE=100

# Memory Configuration
MEMORY_PERSISTENCE=true
MEMORY_PATH=./data/memory

# Plugin Configuration
PLUGIN_PATH=./data/plugins
PLUGIN_AUTO_LOAD=true

# Command Configuration
COMMAND_PREFIX=!
