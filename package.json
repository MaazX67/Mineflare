{
  "name": "mineflare",
  "version": "1.0.0",
  "description": "Professional Minecraft automation framework using Mineflayer with enterprise-grade architecture",
  "type": "module",
  "main": "src/core/index.js",
  "exports": {
    ".": {
      "import": "./src/core/index.js"
    },
    "./bot": "./src/bot/index.js",
    "./commands": "./src/commands/index.js",
    "./tasks": "./src/tasks/index.js",
    "./plugins": "./src/plugins/index.js",
    "./utils": "./src/utils/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "lint": "eslint src tests",
    "docs": "jsdoc -c jsdoc.json",
    "build:dashboard": "cd public && npm run build 2>/dev/null || echo 'Dashboard build skipped'",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "setup": "node scripts/setup.js"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "automation",
    "bot",
    "framework",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "mineflayer": "^4.0.0",
    "mineflayer-pathfinder": "^2.4.0",
    "mineflayer-pvp": "^0.0.21",
    "prismarine-biome": "^1.3.0",
    "prismarine-block": "^1.16.0",
    "prismarine-entity": "^2.4.0",
    "prismarine-item": "^1.15.0",
    "dotenv": "^16.3.1",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0",
    "eventemitter3": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "prettier": "^3.0.3",
    "jsdoc": "^4.0.2"
  }
}
