/**
 * Package.json configuration
 */

{
  "name": "mineflare",
  "version": "1.0.0",
  "description": "Professional Minecraft Automation Framework",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "minecraft",
    "bot",
    "automation",
    "framework",
    "mineflayer"
  ],
  "author": "MaazX67",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "mineflayer": "^4.11.0",
    "mineflayer-pathfinder": "^2.4.0",
    "eventemitter3": "^5.0.0",
    "express": "^4.18.0",
    "socket.io": "^4.5.0",
    "pino": "^8.14.0",
    "pino-pretty": "^10.0.0",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "eslint": "^8.40.0",
    "prettier": "^2.8.0"
  }
}
